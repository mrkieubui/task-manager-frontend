{
  "name": "task-manager-desktop",
  "version": "1.0.0",
  "description": "Task Manager Desktop Application",
  "author": "thanhbv53 <thanhbv53@example.com>",
  "homepage": "https://github.com/thanhbv53/task-manager",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.taskmanager.app",
    "productName": "TaskManager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "src/assets/icon.png"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
